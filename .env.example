# ==========================================
# AutoLog KE — Environment Variables Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/autolog_ke

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production_12345
JWT_EXPIRES_IN=7d

# Cloudinary (Receipt & Vehicle Photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Africa's Talking (SMS Micro-Checkins)
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=AUTOLOG

# Super Admin Bootstrap (Strictly required for npm run seed:admin)
ADMIN_NAME=AutoLog Super Admin
ADMIN_EMAIL=admin@autolog.co.ke
ADMIN_PHONE=+254700000001
ADMIN_PASSWORD=your_super_admin_secure_password

# Safaricom Daraja M-Pesa (Ready for Phase 2 Payments)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
